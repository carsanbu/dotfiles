# ~/.config/swaylock/config
# Traducción de ~/.config/multilock/config (i3lock-color) a swaylock-effects.
# Sintaxis: opción-larga=valor (sin "--").

# Fondo y efectos
image=/home/carlos/.local/share/wallpapers/litox9_backwards_man_far_in_neotokio_cyberpunk_city_with_neons__3134cfec-49a1-4b76-b1f0-d6a88c5794e5.png
scaling=fill
effect-blur=7x5
effect-vignette=0.4:0.5
# effect-pixelate=10   # equivalente a pixel_scale=10,1000 (elige blur o pixel)
color=333333

# Texto e indicador
font=sans-serif
clock
timestr=%T
datestr=%a, %x
text-color=ffffffff
text-ver-color=ffffffff

# Colores del indicador (mismos valores que multilock)
ring-color=ffffffff
ring-ver-color=ffffffff
ring-wrong-color=ffffffff
inside-color=00000000
inside-ver-color=00000000
inside-wrong-color=d23c3dff
separator-color=00000000
key-hl-color=d23c3dff
bs-hl-color=d23c3dff
layout-bg-color=00000066
